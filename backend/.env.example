# Required
SECRET_KEY=change-me-to-a-long-random-string

# Optional (defaults shown)
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional regex list, e.g. ^https://weather-aware-truck-routing.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=
DATABASE_URL=sqlite:///db.sqlite3
# For Postgres: DATABASE_URL=postgres://user:pass@host:5432/dbname
CACHE_URL=locmemcache://
# For a shared cache across instances: CACHE_URL=dbcache://weather_cache  (then run: python manage.py createcachetable)
PLAN_THROTTLE_RATE=30/min

# Third-party providers (all keyless)
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io
SUGGEST_THROTTLE_RATE=120/min
NOMINATIM_USER_AGENT=weather-routing-demo (your-email@example.com)
HTTP_TIMEOUT_SECONDS=15
WEATHER_CACHE_TTL_SECONDS=1800
